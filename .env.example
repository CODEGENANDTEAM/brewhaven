# Brew Haven settings (React and Vite, writing to Firestore, CockroachDB and MySQL).
#
# 1. Copy this file to .env (same folder) and fill in the values.
# 2. .env is listed in .gitignore, so it never goes to GitHub. Keep it that way.
# 3. In production, paste these into Vercel or Netlify environment variables,
#    never into GitHub. Redeploy after you change them.
#
# You do not need all three databases on day one. A database whose variables
# are empty is "not configured": the app skips it and keeps working with the
# others. Start with Firebase, then add CockroachDB and MySQL when you are ready.

# =====================================================================
# PUBLIC: Firebase web app settings (these reach the browser)
# =====================================================================
# WARNING: Vite copies EVERY variable whose name starts with VITE_ into the
# JavaScript that visitors download. Anyone can read them. Only put public
# values here, and never add VITE_ to the name of a secret.
#
# Where to find them: Firebase console > Project settings > General >
# Your apps > the web app you registered > "SDK setup and configuration".
# These four are public by design. The browser only uses them for Google sign in.
# Example values (fake):
#   VITE_FIREBASE_API_KEY=AIzaSyFAKEexampleKEYnotREAL123
#   VITE_FIREBASE_AUTH_DOMAIN=brew-haven-1a2b3.firebaseapp.com
#   VITE_FIREBASE_PROJECT_ID=brew-haven-1a2b3
#   VITE_FIREBASE_APP_ID=1:123456789012:web:abc123def456
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# =====================================================================
# SERVER ONLY: read by the API functions, never sent to the browser
# =====================================================================

# SECRET means: anyone with this value can read your data or use your account.
# Never share it, never commit it, never put it in browser code.

# --- Firebase project (REQUIRED) -------------------------------------
# Firebase console, Project settings, General, "Project ID". Not secret.
# The server uses it to check sign in tokens. Must be the same project as
# VITE_FIREBASE_PROJECT_ID above.
FIREBASE_PROJECT_ID=

# --- Database 1: Firebase Firestore ----------------------------------
# Firebase console, Project settings, Service accounts, Generate new private key.
# Copy client_email and private_key from the JSON file, then delete the file.
# client_email is not secret on its own, like:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-abc12@brew-haven-1a2b3.iam.gserviceaccount.com
FIREBASE_CLIENT_EMAIL=
# SECRET. Paste it inside double quotes, keeping the \n parts exactly as they are, like:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# --- Database 2: CockroachDB Cloud -----------------------------------
# SECRET (it contains the password). CockroachDB Cloud console > your cluster >
# Connect > "General connection string". Like:
# COCKROACH_DATABASE_URL=postgresql://asha:AbCdEf123456@brew-haven-1234.j77.aws-us-east-1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
COCKROACH_DATABASE_URL=
# Optional, not secret. Usually leave it empty: the cluster's certificate is
# normally trusted already. Only fill it in if the logs say
# "self-signed certificate" or "unable to get local issuer certificate".
# One line, \n for line breaks, in double quotes (README part 4 shows how), like:
# COCKROACH_CA_CERT="-----BEGIN CERTIFICATE-----\nMIIF...\n-----END CERTIFICATE-----\n"
COCKROACH_CA_CERT=

# --- Database 3: MySQL on Aiven ---------------------------------------
# SECRET (it contains the password). Aiven console > your MySQL service >
# Overview > Connection information > "Service URI". Like:
# MYSQL_DATABASE_URL=mysql://avnadmin:AVNS_xxxxxxxxxxxx@brew-haven-mysql-yourname.c.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
MYSQL_DATABASE_URL=
# Optional, not secret, but recommended. Aiven service Overview > "CA certificate",
# download ca.pem. Without it the connection is still encrypted, but the server
# does not check WHO it is talking to (a workshop shortcut). One line, \n for
# line breaks, in double quotes (README part 5 shows how), like:
# MYSQL_CA_CERT="-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----\n"
MYSQL_CA_CERT=

# --- Behaviour ----------------------------------------------------------
# Optional, not secret. Which database the shop READS from by default:
# firebase (the default when empty), cockroachdb or mysql.
# Writes always go to every configured database.
PRIMARY_DB=

# Optional: which websites may call this API from a browser (CORS). Not secret.
# This site and its API share one address, so the site itself never needs this.
# Leave it empty and ANY website may call the API (fine here: the API trusts the
# Firebase ID token, not cookies). Fill it in with a comma separated list to
# allow only your own addresses, like:
# ALLOWED_ORIGINS=https://brew-haven.vercel.app,http://localhost:5500
ALLOWED_ORIGINS=
